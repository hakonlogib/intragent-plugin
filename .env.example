# Intragent MCP server (ChatGPT plugin) — copy to .env and fill in.

# The Intragent backend base URL. Used for two things:
#  - forwarding tool calls to {INTRAGENT_BACKEND_URL}/tools/*
#  - it is also the OAuth authorization server (see OAUTH_ISSUER_URL below)
INTRAGENT_BACKEND_URL=http://localhost:8000

# The OAuth issuer = the backend's public URL (must match the backend's
# BACKEND_PUBLIC_URL and the `iss`/metadata it advertises). Usually identical
# to INTRAGENT_BACKEND_URL.
OAUTH_ISSUER_URL=http://localhost:8000

# This MCP server's own public URL, INCLUDING the /mcp path. This is the
# "resource" ChatGPT connects to; it is published in the protected-resource
# metadata. In production this is the HTTPS URL ChatGPT points at.
MCP_PUBLIC_URL=http://localhost:8100/mcp

# Shared with the backend's OAUTH_TOKEN_SECRET so this server can verify the
# HS256 access tokens the backend issues. Must be byte-for-byte the same value.
OAUTH_TOKEN_SECRET=change-me-to-match-the-backend

# Bind address/port for local dev. Behind a proxy in production.
MCP_HOST=127.0.0.1
MCP_PORT=8100

# Optional: HTTP timeout (seconds) for backend tool calls.
# INTRAGENT_BACKEND_TIMEOUT=30
